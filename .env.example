# =============================================================================
# NightShift AI / Alter - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (Clerk)
# Get these from: https://dashboard.clerk.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=    # pk_test_... or pk_live_...
CLERK_SECRET_KEY=                      # sk_test_... or sk_live_...
CLERK_WEBHOOK_SECRET=                  # Optional - whsec_... for Clerk webhooks

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite for local development:
DATABASE_URL=file:./dev.db
# Never run `prisma generate --no-engine` for local SQLite — that build expects
# Prisma Accelerate (`prisma://`) and will throw at runtime. Use plain `prisma generate`.

# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/nightshift

# -----------------------------------------------------------------------------
# Gmail OAuth (for email sync/send)
# Get these from: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=                       # ...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=                   # GOCSPX-...
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# -----------------------------------------------------------------------------
# AI - Anthropic (Primary)
# Get from: https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                     # sk-ant-...

# -----------------------------------------------------------------------------
# AI - OpenAI (Optional - for ChatGPT history import)
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                        # sk-...

# -----------------------------------------------------------------------------
# OpenClaw Integration (Optional - AI Orchestration Service)
# -----------------------------------------------------------------------------
# OpenClaw provides AI orchestration capabilities. If not configured,
# the system falls back to direct Anthropic API calls.
#
# Contact: Ask Royce for credentials
# Status: Integration in progress (see docs/PERSON3_OPENCLAW.md)
#
OPENCLAW_API_URL=                      # e.g., https://your-gateway.example — no trailing slash
OPENCLAW_GATEWAY_PASSWORD=             # Auth token for OpenClaw API (Bearer)
# Set to false to force errors when OpenClaw is down (debugging; orchestration uses ./lib/ai-client.mjs)
OPENCLAW_FALLBACK_ANTHROPIC=true
# Dev gateways with self-signed certs (e.g. Tekton ingress). Set to 1 only in trusted dev environments.
OPENCLAW_TLS_INSECURE=
# If your gateway uses a non-standard path (nginx 404 on /v1/chat/completions), set explicitly, e.g. /api/v1/chat/completions
OPENCLAW_CHAT_PATH=/v1/chat/completions

# Where overnight loop / continuations write files (overrides data/user-config.json)
NIGHTSHIFT_OUTPUT_DIR=data/output

# -----------------------------------------------------------------------------
# Vector Database (Optional)
# -----------------------------------------------------------------------------
# By default, uses local vectra (file-based vector store).
# Uncomment for Pinecone cloud vector DB:
#
# PINECONE_API_KEY=
# PINECONE_INDEX=nightshift

# -----------------------------------------------------------------------------
# API Base URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
