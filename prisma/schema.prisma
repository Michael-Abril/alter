generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String           @id @default(cuid())
  clerkId               String           @unique
  email                 String           @unique
  name                  String?
  gmailConnected        Boolean          @default(false)
  gmailToken            String?
  gmailRefreshToken     String?
  googleScopesVersion   Int              @default(0)
  autonomyLevel         Int              @default(0)
  wakeTime              String           @default("07:00")
  outputDirectory       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  onboardingCompletedAt DateTime?
  actions               Action[]
  boundaries            Boundary[]
  calendarEvents        CalendarEvent[]
  chatMessages          ChatMessage[]
  drafts                Draft[]
  driveDocuments        DriveDocument[]
  emails                Email[]
  githubActivity        GitHubActivity[]
  projects              Project[]
  voiceProfile          VoiceProfile?
}

model Email {
  id            String   @id @default(cuid())
  userId        String
  gmailId       String   @unique
  threadId      String?
  from          String
  to            String
  subject       String
  body          String
  direction     String
  ingestChannel String   @default("inbox")
  isRead        Boolean  @default(false)
  receivedAt    DateTime
  createdAt     DateTime @default(now())
  embedded      Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, direction])
  @@index([userId, ingestChannel])
  @@index([userId, embedded])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  source    String
  role      String
  content   String
  sessionId String?
  timestamp DateTime
  createdAt DateTime @default(now())
  embedded  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, source])
  @@index([userId, embedded])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("in_progress")
  context     String?
  lastActive  DateTime
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Draft {
  id              String   @id @default(cuid())
  userId          String
  type            String
  title           String
  content         String
  targetApp       String
  confidenceScore Float
  status          String   @default("pending")
  context         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Action {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  app         String
  confidence  Float?
  status      String   @default("completed")
  metadata    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Boundary {
  id         String   @id @default(cuid())
  userId     String
  rule       String
  category   String
  action     String
  conditions String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VoiceProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  avgSentenceLen Float?
  formalityScore Float?
  emojiFrequency Float?
  signOffStyle   String?
  toneKeywords   String?
  systemPrompt   String?
  sampleOutputs  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  googleId    String   @unique
  calendarId  String   @default("primary")
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  isAllDay    Boolean  @default(false)
  syncedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
}

model DriveDocument {
  id        String   @id @default(cuid())
  userId    String
  driveId   String   @unique
  title     String
  url       String
  mimeType  String   @default("application/vnd.google-apps.document")
  folderId  String?
  projectId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model GitHubActivity {
  id         String   @id @default(cuid())
  userId     String
  repoName   String
  type       String
  title      String
  body       String?
  url        String
  githubId   String   @unique
  authoredAt DateTime
  syncedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([userId, authoredAt])
}
