generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String   @id @default(cuid())
  clerkId             String   @unique
  email               String   @unique
  name                String?
  gmailConnected      Boolean  @default(false)
  gmailToken          String?
  gmailRefreshToken   String?
  googleScopesVersion Int      @default(0)
  autonomyLevel       Int      @default(0)
  wakeTime            String   @default("07:00")
  outputDirectory     String?
  onboardingCompletedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  emails          Email[]
  chatMessages    ChatMessage[]
  drafts          Draft[]
  actions         Action[]
  projects        Project[]
  boundaries      Boundary[]
  voiceProfile    VoiceProfile?
  calendarEvents  CalendarEvent[]
  driveDocuments  DriveDocument[]
  githubActivity  GitHubActivity[]
}

model Email {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  gmailId       String   @unique
  threadId      String?
  from          String
  to            String
  subject       String
  body          String
  direction     String
  // sent | important_inbox | inbox
  ingestChannel String   @default("inbox")
  isRead        Boolean  @default(false)
  receivedAt    DateTime
  createdAt     DateTime @default(now())
  embedded      Boolean  @default(false)

  @@index([userId, direction])
  @@index([userId, ingestChannel])
  @@index([userId, embedded])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  source    String
  role      String
  content   String
  sessionId String?
  timestamp DateTime
  createdAt DateTime @default(now())
  embedded  Boolean  @default(false)

  @@index([userId, source])
  @@index([userId, embedded])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  status      String   @default("in_progress")
  context     String?
  lastActive  DateTime
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

model Draft {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  title           String
  content         String
  targetApp       String
  confidenceScore Float
  status          String   @default("pending")
  context         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
}

model Action {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  title       String
  description String?
  app         String
  confidence  Float?
  status      String   @default("completed")
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Boundary {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rule       String
  category   String
  action     String
  conditions String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model VoiceProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  avgSentenceLen Float?
  formalityScore Float?
  emojiFrequency Float?
  signOffStyle   String?
  toneKeywords   String?
  systemPrompt   String?
  sampleOutputs  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  googleId    String   @unique
  calendarId  String   @default("primary")
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  isAllDay    Boolean  @default(false)
  syncedAt    DateTime @default(now())

  @@index([userId, startTime])
}

model DriveDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  driveId   String   @unique
  title     String
  url       String
  mimeType  String   @default("application/vnd.google-apps.document")
  folderId  String?
  projectId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model GitHubActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  repoName  String
  type      String
  title     String
  body      String?
  url       String
  githubId  String   @unique
  authoredAt DateTime
  syncedAt  DateTime @default(now())

  @@index([userId, type])
  @@index([userId, authoredAt])
}
